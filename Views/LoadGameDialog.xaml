<Window x:Class="Hangman_Game.Views.LoadGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Load Game" Height="350" Width="400" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Select a saved game to load:" Margin="10" FontWeight="Bold" FontSize="14"/>
        
        <ListBox x:Name="SavesList" Grid.Row="1" Margin="10" SelectionChanged="SavesList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Date:" FontWeight="SemiBold" Foreground="DarkGray"/>
                            <TextBlock Text="Category:" FontWeight="SemiBold" Foreground="DarkGray"/>
                            <TextBlock Text="Level:" FontWeight="SemiBold" Foreground="DarkGray"/>
                            <TextBlock Text="Word length:" FontWeight="SemiBold" Foreground="DarkGray"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SavedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedCategory}" />
                            <TextBlock Text="{Binding CurrentLevel}" />
                            <TextBlock Text="{Binding CurrentWord.Length}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="LoadButton" Content="Load" Width="75" Margin="0,0,10,0" IsEnabled="False" Click="LoadButton_Click"/>
            <Button Content="Cancel" Width="75" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>